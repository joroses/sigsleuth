# SigSleuth settings, read by docker compose and ./scripts/run.sh. Copy this
# file to .env and set at least the MQTT broker and topic.

# MQTT capture (required). One instance records one subscription; wildcards may
# span networks.
SIGSLEUTH_MQTT_HOST=localhost
SIGSLEUTH_MQTT_PORT=1883
SIGSLEUTH_MQTT_TOPIC=msh/+/+/+/#
SIGSLEUTH_MQTT_USERNAME=
SIGSLEUTH_MQTT_PASSWORD=
SIGSLEUTH_MQTT_TLS=false
# Empty for a random one.
SIGSLEUTH_MQTT_CLIENT_ID=

# Optional name shown beside "SigSleuth" in the page, such as the network's.
SIGSLEUTH_NAME=
# Delete receptions older than this many days. 0 means no age limit.
SIGSLEUTH_RETENTION_DAYS=14
# Keep signal survey measurements this many days (never fewer than the packet
# limit). 0 means no limit.
SIGSLEUTH_COVERAGE_RETENTION_DAYS=90
# Hide nodes that turned OK to MQTT off (their history is kept either way).
# false shows every node. Applied at startup.
SIGSLEUTH_HIDE_OPTED_OUT=true
# Stop the clock at this time (ISO 8601 with offset, such as
# 2026-10-12T16:46:00Z) to show a saved database the same way every day.
# Only with `python -m sigsleuth api`. The page reads it from the environment
# when it is built (pnpm build, ./scripts/web.sh), not from this file.
SIGSLEUTH_FIXED_NOW=

# Where the page is served. Local only by default: a public server puts a
# reverse proxy with HTTPS in front (docs/deployment.md).
SIGSLEUTH_API_HOST=127.0.0.1
SIGSLEUTH_API_PORT=8000
# Passwords for Diagnostics and for signal survey uploads (HTTP Basic, any user
# name). Give surveyors only the upload one. Unset, Diagnostics is open and
# uploads are refused.
SIGSLEUTH_ADMIN_PASSWORD=
SIGSLEUTH_UPLOAD_PASSWORD=
SIGSLEUTH_LOG_LEVEL=INFO

# Without Docker only; docker compose keeps the database in a volume.
SIGSLEUTH_DATABASE_PATH=./data/sigsleuth.db

# Development only: the Vite server (./scripts/web.sh) and verify.sh's browser tests.
SIGSLEUTH_WEB_PORT=5173
SIGSLEUTH_E2E_PORT=4173
